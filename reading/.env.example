# Reading module configuration.
#
# Copy to reading/.env and fill in.  .env is gitignored — never commit real keys.
# Every value here is optional except DEEPSEEK_API_KEY, which is only needed for
# ingest (and for the optional tap-time disambiguation endpoint).  The reader
# itself works with no key at all.

# --- DeepSeek -----------------------------------------------------------------
# Required for ingest.  Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=120
DEEPSEEK_MAX_RETRIES=3

# --- storage ------------------------------------------------------------------
# Defaults live under reading/data/ and are gitignored.
# READING_DB_PATH=./data/reading.sqlite3
# READING_DICT_PATH=./data/dictionary.sqlite3
# READING_SITE_DIR=./data/site

# --- RSS sources --------------------------------------------------------------
# VOA publishes opaque /api/<id> feeds; the ids below are the "Tin tức" and
# "Việt Nam" channels from https://www.voatiengviet.com/rssfeeds
# Comma-separated.  A feed that fails is skipped, not fatal.
VOA_RSS_URLS=https://www.voatiengviet.com/api/zkvypl-vomx-tpejqup,https://www.voatiengviet.com/api/zbuyil-vomx-tpeqpum
BBC_RSS_URLS=https://feeds.bbci.co.uk/vietnamese/rss.xml

# --- scraping -----------------------------------------------------------------
# Fetch the full article page and strip boilerplate.  When off (or when a page
# cannot be parsed) the RSS summary is used instead.
READING_FETCH_FULL=true
READING_HTTP_TIMEOUT_S=30
# Politeness delay between article fetches, seconds.
READING_FETCH_DELAY_S=1.0
READING_USER_AGENT=nghe-reading/0.1 (+https://github.com/councilgritter/nghe_expanded)

# --- pipeline -----------------------------------------------------------------
# Longest headword the dictionary will enforce as one word.  The bundled
# underthesea word lists contain whole proverbs (up to 17 syllables); letting
# those win would swallow entire clauses.
READING_MAX_COMPOUND_SYLLABLES=4
READING_DEFAULT_CEFR=B1
# Max new (article, level) pairs per run.  0 = unlimited.
READING_INGEST_LIMIT=0
