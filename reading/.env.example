# Reading module configuration.
#
# Copy to reading/.env and fill in.  .env is gitignored — never commit real keys.
# Every value here is optional except DEEPSEEK_API_KEY, which is only needed for
# ingest (and for the optional tap-time disambiguation endpoint).  The reader
# itself works with no key at all.

# --- DeepSeek -----------------------------------------------------------------
# Required for ingest.  Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash is what the current pricing page names; deepseek-chat was the old
# alias. deepseek-v4-pro costs ~4x for work this pipeline does not need.
#
# This is a behavioural choice, not just a price.  deepseek-flash thinks before it
# answers, and that thinking is what makes it rewrite the article: with thinking
# disabled it returns the source verbatim.  The retired deepseek-chat alias behaves
# that way, which is why pinning it here silently produced unsimplified articles.
DEEPSEEK_MODEL=deepseek-flash
# Generous on purpose: thinking is billed as completion tokens and the request is not
# streamed, so nothing arrives until the whole answer is ready.  A full 8,000-character
# article can take minutes, and a 120 s read timeout drops the connection mid-answer.
DEEPSEEK_TIMEOUT_S=600
DEEPSEEK_MAX_RETRIES=3

# --- off-peak guard -----------------------------------------------------------
# Ingest spends money, so it refuses to start during DeepSeek's peak hours (double
# price) unless explicitly approved. Peak is 01:00-04:00 and 06:00-10:00 UTC,
# Mon-Fri, excluding Chinese public holidays; all other hours are off-peak, and
# off-peak rates are half. https://api-docs.deepseek.com/quick_start/pricing/
# Leave READING_ALLOW_PEAK unset for the safe default; --allow-peak approves one run.
# READING_ALLOW_PEAK=false
# READING_PEAK_WINDOWS=01:00-04:00,06:00-10:00
# READING_PEAK_WEEKDAYS=Mon,Tue,Wed,Thu,Fri
# Days you know to be Chinese public holidays, off-peak all day. Without this a
# holiday is treated as peak and the run waits — the conservative reading.
# READING_OFFPEAK_DATES=2026-10-01,2026-10-02

# --- storage ------------------------------------------------------------------
# Defaults live under reading/data/ and are gitignored.
# READING_DB_PATH=./data/reading.sqlite3
# READING_DICT_PATH=./data/dictionary.sqlite3
# READING_SITE_DIR=./data/site

# --- RSS sources --------------------------------------------------------------
# VOA publishes opaque /api/<id> feeds; the ids below are the "Tin tức" and
# "Việt Nam" channels from https://www.voatiengviet.com/rssfeeds
# Comma-separated.  A feed that fails is skipped, not fatal.
VOA_RSS_URLS=https://www.voatiengviet.com/api/zkvypl-vomx-tpejqup,https://www.voatiengviet.com/api/zbuyil-vomx-tpeqpum
BBC_RSS_URLS=https://feeds.bbci.co.uk/vietnamese/rss.xml

# --- scraping -----------------------------------------------------------------
# Fetch the full article page and strip boilerplate.  When off (or when a page
# cannot be parsed) the RSS summary is used instead.
READING_FETCH_FULL=true
READING_HTTP_TIMEOUT_S=30
# Politeness delay between article fetches, seconds.
READING_FETCH_DELAY_S=1.0
READING_USER_AGENT=nghe-reading/0.1 (+https://github.com/councilgritter/nghe_expanded)
# Shortest body worth turning into a reading exercise.  VOA mixes full text articles
# with video pieces whose page carries only a two-sentence lede; those make useless
# drills, so items below this length are skipped before the paid simplification call.
READING_MIN_BODY_CHARS=400

# --- pipeline -----------------------------------------------------------------
# Longest headword the dictionary will enforce as one word.  The bundled
# underthesea word lists contain whole proverbs (up to 17 syllables); letting
# those win would swallow entire clauses.
READING_MAX_COMPOUND_SYLLABLES=4
READING_DEFAULT_CEFR=B1
# Max new (article, level) pairs per run.  0 = unlimited.
READING_INGEST_LIMIT=0

# --- object storage (only for tools/r2_sync.py) --------------------------------
# A CI run needs two files that are deliberately not committed: the reading database
# (ingest's dedupe lives in it — without it every run re-pays for every article) and
# the 15 MB dictionary (without it segmentation loses its compound constraint).
# r2_sync moves both to and from the same R2 bucket the audio uses.
#   python -m reading.tools.r2_sync get     # before a run
#   python -m reading.tools.r2_sync put     # after one
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# READING_R2_PREFIX=reading
